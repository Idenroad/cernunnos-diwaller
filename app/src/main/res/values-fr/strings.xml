    <string name="import_aegis_pass">Passphrase Aegis (si chiffré)</string>
    <string name="import_aegis_button">Importer depuis Aegis</string>
    <string name="import_2fas_desc">Importer depuis 2FAS Authenticator. Exportez sans chiffrement depuis 2FAS (Paramètres → Sauvegarde → Exporter sans mot de passe), puis choisissez le fichier .2fas ici.</string>
    <string name="import_authy_desc">Importer depuis Authy. Utilisez un outil d\'export Authy tiers (ex. authy-export) pour produire un fichier JSON, puis choisissez-le ici.</string>
    <string name="import_microsoft_desc">Importer depuis Microsoft Authenticator. Utilisez un outil d\'export tiers pour produire un fichier JSON, puis choisissez-le ici.</string>
    <string name="import_freeotp_desc">Importer depuis FreeOTP / FreeOTP+. Exportez vos jetons en XML, puis choisissez le fichier ici.</string>
    <string name="import_andotp_desc">Importer depuis andOTP. Exportez sans chiffrement depuis andOTP (Paramètres → Exporter → Texte brut), puis choisissez le fichier JSON ici.</string>
    <string name="import_raivo_desc">Importer depuis Raivo OTP (iOS). Exportez vos entrées en JSON, puis choisissez le fichier ici.</string>
    <string name="import_lastpass_desc">Importer depuis LastPass Authenticator. Exportez en CSV, puis choisissez le fichier ici.</string>
    <string name="import_steam_desc">Importer le secret Steam Guard depuis un export JSON de Steam Desktop Authenticator. Note : Steam utilise un algorithme personnalisé — les codes peuvent ne pas correspondre à l\'app Steam. Gardez Steam Guard sur un appareil séparé.</string>
    <string name="import_plain_desc">Importer depuis un fichier texte contenant une URI otpauth:// par ligne. Compatible avec WinAuth et les listes d\'URI génériques. Les lignes commençant par # sont ignorées.</string>

