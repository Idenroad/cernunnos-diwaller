    <!-- Import Aegis -->
    <string name="import_aegis_desc">Importation depuis Aegis Authenticator. Supporte les exports en clair et chiffrés.</string>
    <string name="import_aegis_hint">Dans Aegis : Paramètres → Exporter → choisir clair ou chiffré. Si chiffré, entrez la passphrase ci-dessous.</string>
