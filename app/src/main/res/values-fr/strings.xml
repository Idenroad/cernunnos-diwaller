    <!-- Import Google Authenticator -->
    <string name="import_google_desc">Importation depuis Google Authenticator. Collez l\'URI otpauth-migration:// exportée depuis Google Authenticator.</string>
    <string name="import_google_steps">Étapes : Google Authenticator → trois points → Transférer des comptes → Exporter des comptes → scanner le QR avec un autre appareil → copier l\'URI otpauth-migration:// ci-dessous.</string>
