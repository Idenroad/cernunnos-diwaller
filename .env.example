# Cernunnos Authenticator — Cloud Provider Keys
#
# Copy this file to .env and fill in your own keys.
# The .env file is read at build time by app/build.gradle.kts
# and injected as BuildConfig fields.
#
# DO NOT commit the .env file — it contains your private API keys.
# .env is already in .gitignore.

# Google Drive OAuth Client ID
# 1. Go to https://console.cloud.google.com/
# 2. Create project → Enable Google Drive API
# 3. Credentials → Create OAuth client ID → Android (or Web)
# 4. Add redirect URI: com.cernunnos.authenticator:/oauth2redirect
# 5. Copy the Client ID here
CERNUNNOS_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Dropbox App Key
# 1. Go to https://www.dropbox.com/developers/apps
# 2. Create app → Dropbox API → Full Dropbox access
# 3. Add redirect URI: com.cernunnos.authenticator:/oauth2redirect
# 4. Copy the App key here
CERNUNNOS_DROPBOX_APP_KEY=your-dropbox-app-key
